{
  "name": "website",
  "version": "1.0.0",
  "private": true,
  "description": "",
  "scripts": {
    "prepare": "bamboo codegen",
    "dev:content": "velite --watch",
    "dev:next": "next dev",
    "dev": "run-p dev:*",
    "build:content": "velite --clean",
    "build:og": "tsx --tsconfig scripts/tsconfig.json scripts/generate-og-images.tsx",
    "build:logo": "tsx --tsconfig scripts/tsconfig.json scripts/generate-logo-assets.tsx",
    "build:next": "next build",
    "//build": "Steps are named rather than globbed: og reads the velite collection and writes into public/, so it has to sit between the two.",
    "build": "run-s build:content build:og build:next",
    "prebuild": "pnpm --filter=../packages/** build",
    "check-links": "node scripts/check-links.mjs",
    "lint": "oxlint .",
    "start": "next start"
  },
  "dependencies": {
    "@ark-ui/react": "5.18.3",
    "@bamboocss/preset-bamboo": "workspace:*",
    "@bamboocss/token-dictionary": "workspace:*",
    "fuse.js": "^7.1.0",
    "next": "15.5.7",
    "npm-run-all": "^4.1.5",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-icons": "5.5.0",
    "scroll-into-view-if-needed": "3.1.0"
  },
  "devDependencies": {
    "@bamboocss/dev": "workspace:*",
    "@resvg/resvg-js": "^2.6.2",
    "@shikijs/rehype": "^3.19.0",
    "@shikijs/transformers": "^3.19.0",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "10.5.4",
    "oxlint": "1.66.0",
    "postcss": "8.5.26",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "satori": "^0.29.0",
    "shiki": "^3.19.0",
    "tsx": "4.20.6",
    "unist-util-visit": "^5.0.0",
    "velite": "0.3.0"
  }
}
